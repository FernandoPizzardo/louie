{
  "name": "louie-desktop",
  "productName": "Louie",
  "version": "1.0.1",
  "private": true,
  "author": "Fernando Pizzardo",
  "description": "Louie - Charles-style HTTP/HTTPS intercepting proxy. AI-generated app; desktop shell for Linux and Windows.",
  "homepage": "https://github.com/FernandoPizzardo/louie",
  "main": "src/main.js",
  "scripts": {
    "build:ui": "npm --prefix ../web run build",
    "start": "npm run build:ui && electron .",
    "dist": "npm run dist:linux",
    "dist:linux": "npm run build:ui && electron-builder --linux",
    "dist:win": "npm run build:ui && electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
